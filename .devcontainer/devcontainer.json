// See https://containers.dev/implementors/json_reference/
{
	"name": "clementlepriol.fr (Hugo)",
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",
	"features": {
		"ghcr.io/devcontainers/features/hugo:1": {
			"extended": true,
			// Keep in sync with HUGO_VERSION in .github/workflows/deploy.yml
			"version": "0.169.0"
		},
		// Node + Chromium are only used by `make check` (Lighthouse, HTML validation)
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		}
	},
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends chromium make",
	"containerEnv": {
		"CHROME_PATH": "/usr/bin/chromium"
	},
	"forwardPorts": [1313],
	"portsAttributes": {
		"1313": { "label": "Hugo server", "onAutoForward": "openBrowser" }
	}
}
